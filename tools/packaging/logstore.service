[Unit]
Description=Logstore service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=logstore
ExecStart=/usr/bin/logstore -config.file /etc/logstore/config.yml
# Give a reasonable amount of time for the server to start up/shut down
TimeoutSec = 120
Restart = on-failure
RestartSec = 2

[Install]
WantedBy=multi-user.target
