# Development environment variables for Logstore UI

# Enable mock features mode (uses mock data instead of API calls)
VITE_MOCK_FEATURES=false

# Enable Goldfish feature in development
VITE_ENABLE_GOLDFISH=true

# Goldfish namespace configuration for development
VITE_GOLDFISH_CELL_A_NAMESPACE=logstore-ops-002
VITE_GOLDFISH_CELL_B_NAMESPACE=logstore-ops-003